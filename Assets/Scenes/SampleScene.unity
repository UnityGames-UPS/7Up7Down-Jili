  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bet on the first card in position <color=#F39D43>Andar</color> or <color=#F39D43>Bahar</color>
    \nthat matches with the Middle card.\n\nIf the middle card is Black, Andar will
    be dealt the card first. \nSo the payout will be <color=#F39D43>1st Andar 1:15.5</color>
    | <color=#F39D43>1st Bahar 1:15</color>.\n\nIf the middle card is Red, Bahar
    will be dealt the card first. \nSo the payout will be <color=#F39D43>1st Andar
    1:15.5</color> | <color=#F39D43>1st Bahar 1:15</color>.\n"
